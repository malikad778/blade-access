{
    "name": "malikad778/laravel-blade-ally",
    "description": "Static Accessibility Analyzer for Laravel Blade & Livewire Templates",
    "keywords": ["laravel", "accessibility", "wcag", "blade", "livewire", "static-analysis"],
    "license": "MIT",
    "authors": [
        {
            "name": "Adnan Malik",
            "email": "adnan@webwhizy.com",
            "homepage": "https://webwhizy.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "pestphp/pest": "^2.0|^3.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "MalikAd778\\BladeAlly\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MalikAd778\\BladeAlly\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MalikAd778\\BladeAlly\\BladeAllyServiceProvider"
            ],
            "aliases": {
                "BladeAlly": "MalikAd778\\BladeAlly\\Facades\\BladeAlly"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
